<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="WidgetItem">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">7dp</item>
        <item name="android:background">@drawable/bg_widget_item</item>
        <item name="android:paddingHorizontal">11dp</item>
        <item name="android:paddingVertical">8dp</item>
        <item name="android:maxLines">3</item>
        <item name="android:ellipsize">end</item>
        <item name="android:lineSpacingMultiplier">1.3</item>
        <item name="android:textColor">#EAECF0</item>
        <item name="android:textSize">13sp</item>
    </style>
</resources>
